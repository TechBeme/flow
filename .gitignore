# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing and local reports
/coverage
/test-results
/playwright-report
/.nyc_output

# next.js
/.next/
/out/

# production
/build

# local tools and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (the public template is intentionally tracked)
.env*
!.env.example

# credentials and local data
*service-account*.json
*service_account*.json
sa-key*.json
/credentials.json
/google-credentials.json
/vertex.json
*.sqlite
*.sqlite3
*.db
*.dump

# generated media and temporary captures
/generated/
/screenshots/
/tmp/
*.webm
*.mp4

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
